# {{ ansible_managed }}
[Unit]
Description=darkice - publica {{ snapcast_main_stream_name }} como stream en Icecast
After=icecast-sink.service
Requires=icecast-sink.service

[Service]
Type=simple
ExecStart=/usr/bin/darkice -c /etc/darkice.cfg
Restart=on-failure
RestartSec=10
# darkice pide prioridad de tiempo real para no perder muestras al capturar.
# El limite duro del usuario suele ser 0, asi que igual avisa por log; con
# bufferSecs={{ darkice_buffer_secs }} no se noto en la practica.
LimitRTPRIO=99
LimitNICE=-20

[Install]
WantedBy=default.target
