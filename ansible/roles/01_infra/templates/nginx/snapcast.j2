# {{ ansible_managed }}
#
# ATENCION: este vhost NO tiene autenticacion propia. Snapcast tampoco: su
# JSON-RPC responde 200 sin credenciales, y con el control script instalado eso
# significa control total sobre la reproduccion de Spotify y sobre el volumen de
# cada parlante.
#
# Se expone a proposito sin auth porque la proteccion vive en Cloudflare Access
# (Zero Trust), delante del tunel. Si se publica este hostname SIN una politica
# de Access configurada, queda completamente abierto a internet.
server {
    listen 80;
    listen [::]:80;
    server_name snapcast.{{ main_domain }};

    # Snapweb abre DOS WebSockets contra snapserver:
    #   /jsonrpc  control y metadata (ese path recibe ademas POST de JSON-RPC plano)
    #   /stream   el audio, en frames binarios
    # Por eso las cabeceras de upgrade van a nivel de server y las hereda todo
    # el vhost. Son condicionales via el map de conf.d/websocket-upgrade.conf,
    # asi que los requests normales no se rompen.
    #
    # Nota: nginx solo hereda estos proxy_set_header si el location NO define
    # los suyos. Si se agrega un proxy_set_header dentro de un location, hay que
    # repetir el bloque entero ahi.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Conexiones largas y continuas: sin timeouts amplios nginx las corta, y con
    # buffering el audio llega a tirones.
    location ~ ^/(stream|jsonrpc)$ {
        proxy_pass http://127.0.0.1:{{ snapcast_http_port | default(1780) }};
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ snapcast_http_port | default(1780) }};
    }
}
