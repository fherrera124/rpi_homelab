# {{ ansible_managed }}
[Unit]
Description=Cliente de la Sangean: reproduce {{ snapcast_main_stream_name }} hacia Icecast
Documentation=https://github.com/badaix/snapcast
After=icecast-sink.service
Requires=icecast-sink.service

[Service]
Type=simple
# El mixer deja aca el valor deseado del slider para poder coalescer.
RuntimeDirectory=sangean-mixer
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/snapclient \
  --host 127.0.0.1 \
  --hostID {{ sangean_client_id }} \
  --player pulse \
  --soundcard {{ icecast_sink }} \
  --mixer script:/usr/local/bin/sangean-mixer.sh \
  --logsink stderr \
  --logfilter {{ sangean_log_filter }}
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
