# {{ ansible_managed }}
# Hub de distribucion: Soloist (Spotify Connect) -> FIFOs -> snapclients de la LAN.
# Sin parlantes locales en este equipo.

[server]
threads = -1

[stream]
{% for s in snapcast_streams %}
source = pipe://{{ s.fifo }}?name={{ s.name }}&sampleformat={{ snapcast_sampleformat }}&codec={{ s.codec }}&mode=create
{% endfor %}
buffer = {{ snapcast_buffer_ms }}

[http]
enabled = true
port = {{ snapcast_http_port }}
doc_root = {{ snapcast_doc_root }}

[tcp]
enabled = true
port = {{ snapcast_tcp_port }}
