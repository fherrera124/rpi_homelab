# {{ ansible_managed }}
[Unit]
Description=Soloist - receptor Spotify Connect hacia Snapcast
After=soloist-pipe-sink.service
Requires=soloist-pipe-sink.service

[Service]
Type=simple
EnvironmentFile=/etc/default/soloist
EnvironmentFile=/etc/soloist/soloist.env
# Soloist resuelve sus directorios desde $STATE_DIRECTORY / $CACHE_DIRECTORY,
# que systemd exporta gracias a estas dos directivas. Sin ellas, $HOME de un
# usuario de sistema resuelve a "/" y falla con "Permission denied".
StateDirectory=soloist
CacheDirectory=soloist
ExecStart={{ soloist_binary }} --device-name ${DEVICE_NAME} --api-key ${SOLOIST_API_KEY} --pipewire-device soloist_sink --cache-size ${CACHE_MB} --ws 127.0.0.1:{{ soloist_ws_port }}
Restart=on-failure
RestartSec=10
# El audio no debe ganarle CPU a los servicios criticos del equipo.
Nice={{ soloist_nice }}
CPUWeight={{ soloist_cpu_weight }}

[Install]
WantedBy=default.target
