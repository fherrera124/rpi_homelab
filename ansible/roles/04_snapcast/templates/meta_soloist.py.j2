#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# {{ ansible_managed }}
#
# Control script de Snapcast para Soloist: publica la metadata de Spotify
# Connect en la API de Snapcast y traduce los comandos de transporte que
# llegan desde Snapweb.
#
# Modelado sobre meta_librespot-java.py, que viene con snapserver y resuelve
# el caso analogo con librespot.
#
# A diferencia de aquel, este NO usa una libreria WebSocket de Python: habla
# con Soloist a traves de "soloist ctl", que ya expone la WS por linea de
# comandos. Es una dependencia menos que instalar en la Pi.
#
# El puerto de la WS se pasa por parametro en vez de leerse de
# <data-dir>/ws.port, porque snapserver ejecuta este script como _snapserver
# y ese archivo vive en un directorio 700 del usuario soloist.
#
# Registro en snapserver.conf:
#   source = pipe:///run/snapcast/soloist?name=Soloist&...
#            &controlscript=meta_soloist.py&controlscriptparams=--ws-port=9876

import getopt
import json
import logging
import subprocess
import sys
import threading
import time

logger = logging.getLogger('meta_soloist')

params = {
    'soloist-bin': '{{ soloist_binary }}',
    'ws-host': '127.0.0.1',
    'ws-port': {{ soloist_ws_port }},
    # Snapserver agrega estos por su cuenta a lo que se declare en
    # controlscriptparams: --stream, --snapcast-host y --snapcast-port. No los
    # usamos (hablamos con snapserver por stdin/stdout), pero hay que
    # aceptarlos o getopt aborta con "option --stream not recognized".
    'stream': 'default',
    'snapcast-host': 'localhost',
    'snapcast-port': 1780,
}

# Soloist ya nos dice que puede hacer en cada momento via available_actions;
# estas son las claves que nos interesan y su equivalente en Snapcast.
# play/pause quedan fuera: se resuelven aparte, ver mas abajo.
ACTION_MAP = {
    'seek': 'canSeek',
    'skip_next': 'canGoNext',
    'skip_prev': 'canGoPrevious',
}

REPEAT_MAP = {'off': 'none', 'context': 'playlist', 'track': 'track'}

# Preferencia de tamano de caratula. Soloist publica varias; las carga el
# navegador directo del CDN de Spotify, no las proxeamos.
COVER_PREFERENCE = ('large', 'xlarge', 'default', 'small')

_stdout_lock = threading.Lock()


def send(json_msg):
    """Escribe un mensaje JSON-RPC a snapserver. Una linea por mensaje."""
    with _stdout_lock:
        sys.stdout.write(json.dumps(json_msg))
        sys.stdout.write('\n')
        sys.stdout.flush()


def _dig(obj, *keys, default=None):
    """Navega diccionarios anidados sin explotar si falta un nivel."""
    for key in keys:
        if not isinstance(obj, dict) or key not in obj:
            return default
        obj = obj[key]
    return obj


class SoloistControl(object):
    """Puente entre la WS de Soloist y la API de control de Snapcast."""

    def __init__(self, params):
        self._params = params
        self._lock = threading.Lock()
        self._properties = {
            'canControl': True,
            'canGoNext': False,
            'canGoPrevious': False,
            'canPause': False,
            'canPlay': False,
            'canSeek': False,
            'playbackStatus': 'stopped',
            'loopStatus': 'none',
            'shuffle': False,
            'position': 0.0,
            'metadata': {},
        }
        # position viene con el instante en que se midio; guardamos ese
        # instante para poder extrapolar sin pedirle nada a Soloist.
        self._position_ms = 0
        self._position_ts = 0
        self._speed = 0

    # ---------------------------------------------------------------- salida

    def _ctl(self, *args):
        """Ejecuta 'soloist ctl ...' contra la WS."""
        cmd = [
            self._params['soloist-bin'], 'ctl',
            '-w', '{}:{}'.format(self._params['ws-host'], self._params['ws-port']),
        ] + list(args)
        logger.debug('ctl: %s', ' '.join(cmd))
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        except (subprocess.SubprocessError, OSError) as exc:
            logger.error('fallo ejecutando ctl %s: %s', args, exc)
            return None

    def _publish(self):
        send({'jsonrpc': '2.0',
              'method': 'Plugin.Stream.Player.Properties',
              'params': self.properties()})

    def properties(self):
        """Propiedades actuales, con la posicion extrapolada al momento."""
        with self._lock:
            props = dict(self._properties)
            props['metadata'] = dict(self._properties['metadata'])
            position_ms = self._position_ms
            if self._speed and self._position_ts:
                position_ms += (time.time() * 1000.0) - self._position_ts
            props['position'] = max(0.0, position_ms / 1000.0)
        return props

    # ------------------------------------------------------- eventos de WS

    def _metadata_from_item(self, item, context):
        metadata = {}
        if not item:
            return metadata

        title = _dig(item, 'decorations', 'identity', 'name')
        if title:
            metadata['title'] = title

        artists = [
            name for name in (
                _dig(c, 'entity', 'decorations', 'identity', 'name')
                for c in _dig(item, 'decorations', 'creators', default=[]) or []
            ) if name
        ]
        if artists:
            metadata['artist'] = artists

        album = _dig(item, 'decorations', 'parent', 'entity',
                     'decorations', 'identity', 'name')
        if not album:
            # Podcasts y algunos contextos no traen album: cae al nombre
            # del contexto (playlist, show) para no dejar el campo vacio.
            album = _dig(context, 'decorations', 'identity', 'name')
        if album:
            metadata['album'] = album

        covers = {
            c.get('size'): c.get('url')
            for c in _dig(item, 'decorations', 'visual_identity', 'cover',
                          default=[]) or []
            if c.get('url')
        }
        for size in COVER_PREFERENCE:
            if size in covers:
                metadata['artUrl'] = covers[size]
                break

        duration_ms = _dig(item, 'decorations', 'playback', 'duration_ms')
        if duration_ms:
            metadata['duration'] = duration_ms / 1000.0

        if item.get('uri'):
            metadata['trackId'] = item['uri']

        return metadata

    def on_playback_state(self, msg):
        status = msg.get('status')
        item = msg.get('item') or {}
        actions = msg.get('available_actions') or {}
        options = msg.get('options') or {}
        position = msg.get('position') or {}

        with self._lock:
            if status == 'playing':
                self._properties['playbackStatus'] = 'playing'
            elif status == 'paused':
                self._properties['playbackStatus'] = 'paused'
            else:
                self._properties['playbackStatus'] = 'stopped'

            for action, prop in ACTION_MAP.items():
                self._properties[prop] = action in actions

            # Spotify publica "play" y "pause" de forma mutuamente excluyente
            # segun el estado: reproduciendo ofrece pause pero no play, y al
            # reves. Snapcast en cambio usa canPlay/canPause para habilitar
            # comandos, no para describir el instante: si canPause es false
            # rechaza el comando con "Stream property canPause is false".
            # Por eso, si cualquiera de las dos acciones esta disponible, el
            # transporte funciona y ambos flags van en true. Snapweb decide
            # que icono mostrar mirando playbackStatus.
            can_transport = ('play' in actions) or ('pause' in actions)
            self._properties['canPlay'] = can_transport
            self._properties['canPause'] = can_transport

            self._properties['shuffle'] = bool(options.get('shuffle', False))
            self._properties['loopStatus'] = REPEAT_MAP.get(
                options.get('repeat'), 'none')

            self._position_ms = position.get('position_ms', 0)
            self._position_ts = position.get('timestamp_ms', 0)
            self._speed = position.get('speed', 0)

            self._properties['metadata'] = self._metadata_from_item(
                item, msg.get('context'))

        self._publish()

    def trace_loop(self):
        """Lee eventos de 'soloist ctl trace' y los reenvia a snapserver.

        Reintenta con backoff: si Soloist se reinicia (por ejemplo tras una
        actualizacion del binario), ctl termina y hay que reconectar.
        """
        backoff = 1
        while True:
            proc = None
            try:
                proc = subprocess.Popen(
                    [self._params['soloist-bin'], 'ctl',
                     '-w', '{}:{}'.format(self._params['ws-host'],
                                          self._params['ws-port']),
                     'trace'],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True, bufsize=1)
                send({'jsonrpc': '2.0', 'method': 'Plugin.Stream.Ready'})
                backoff = 1
                for line in proc.stdout:
                    line = line.strip()
                    if not line:
                        continue
                    # Formato: "<timestamp_ms> <json>". La primera linea es
                    # un aviso de conexion en texto plano.
                    brace = line.find('{')
                    if brace < 0:
                        continue
                    try:
                        msg = json.loads(line[brace:])
                    except ValueError:
                        continue
                    if msg.get('type') == 'playback_state':
                        self.on_playback_state(msg)
            except Exception as exc:
                logger.error('trace termino: %s', exc)
            finally:
                if proc:
                    proc.terminate()

            logger.warning('reconectando a Soloist en %ss', backoff)
            time.sleep(backoff)
            backoff = min(backoff * 2, 30)

    # ---------------------------------------------- comandos de snapserver

    def control(self, cmd_line):
        request_id = None
        try:
            request = json.loads(cmd_line)
            request_id = request.get('id')
            interface, cmd = request['method'].rsplit('.', 1)

            if interface != 'Plugin.Stream.Player':
                return send({'jsonrpc': '2.0', 'id': request_id,
                             'error': {'code': -32601,
                                       'message': 'Method not found'}})

            if cmd == 'Control':
                command = request['params']['command']
                cmd_params = request['params'].get('params', {})
                self._do_control(command, cmd_params)

            elif cmd == 'SetProperty':
                self._do_set_property(request['params'])

            elif cmd == 'GetProperties':
                return send({'jsonrpc': '2.0', 'id': request_id,
                             'result': self.properties()})

            else:
                return send({'jsonrpc': '2.0', 'id': request_id,
                             'error': {'code': -32601,
                                       'message': 'Method not found'}})

            send({'jsonrpc': '2.0', 'id': request_id, 'result': 'ok'})

        except Exception as exc:
            send({'jsonrpc': '2.0', 'id': request_id,
                  'error': {'code': -32700, 'message': 'Parse error',
                            'data': str(exc)}})

    def _do_control(self, command, cmd_params):
        if command == 'next':
            self._ctl('next')
        elif command == 'previous':
            self._ctl('prev')
        elif command == 'play':
            self._ctl('play')
        elif command in ('pause', 'stop'):
            self._ctl('pause')
        elif command == 'playPause':
            with self._lock:
                playing = self._properties['playbackStatus'] == 'playing'
            self._ctl('pause' if playing else 'play')
        elif command == 'setPosition':
            self._ctl('seek', str(int(float(cmd_params['position']) * 1000)))
        elif command == 'seek':
            # Snapcast manda un desplazamiento relativo; lo resolvemos contra
            # la posicion extrapolada.
            offset_ms = float(cmd_params['offset']) * 1000.0
            target = max(0, int(self.properties()['position'] * 1000 + offset_ms))
            self._ctl('seek', str(target))
        else:
            logger.warning('comando no soportado: %s', command)

    def _do_set_property(self, prop):
        # El volumen queda deliberadamente afuera: Snapcast ya tiene volumen
        # por cliente, que es el que corresponde. Mapearlo a Soloist bajaria
        # la fuente para todos los parlantes a la vez.
        if 'shuffle' in prop:
            self._ctl('shuffle', 'on' if prop['shuffle'] else 'off')
        if 'loopStatus' in prop:
            reverse = {v: k for k, v in REPEAT_MAP.items()}
            value = reverse.get(prop['loopStatus'])
            if value:
                self._ctl('repeat', value)


def usage(params):
    print("""\
Usage: meta_soloist.py [OPTION]...

     --soloist-bin=PATH   Ruta al binario de soloist (default: %(soloist-bin)s)
     --ws-host=ADDR       Direccion de la WS de soloist (default: %(ws-host)s)
     --ws-port=PORT       Puerto de la WS de soloist (default: %(ws-port)s)

     -h, --help           Muestra esta ayuda
     -d, --debug          Modo debug
""" % params)


if __name__ == '__main__':
    try:
        opts, _ = getopt.getopt(
            sys.argv[1:], 'hd',
            ['help', 'debug', 'soloist-bin=', 'ws-host=', 'ws-port=',
             'stream=', 'snapcast-host=', 'snapcast-port='])
    except getopt.GetoptError as ex:
        # Tolerante a proposito: si una version futura de snapserver agrega
        # otro parametro, el plugin sigue funcionando en vez de morir al
        # arrancar. Se avisa por stderr, que snapserver registra.
        print('%s: %s (se ignora)' % (sys.argv[0], ex), file=sys.stderr)
        opts = []

    log_level = logging.WARNING
    for opt, arg in opts:
        if opt in ('-h', '--help'):
            usage(params)
            sys.exit()
        elif opt in ('-d', '--debug'):
            log_level = logging.DEBUG
        elif opt == '--soloist-bin':
            params['soloist-bin'] = arg
        elif opt == '--ws-host':
            params['ws-host'] = arg
        elif opt == '--ws-port':
            params['ws-port'] = int(arg)
        elif opt == '--stream':
            params['stream'] = arg
        elif opt == '--snapcast-host':
            params['snapcast-host'] = arg
        elif opt == '--snapcast-port':
            params['snapcast-port'] = int(arg)

    logging.basicConfig(stream=sys.stderr, level=log_level,
                        format='%(asctime)s %(levelname)s: %(message)s')

    ctrl = SoloistControl(params)

    tracer = threading.Thread(target=ctrl.trace_loop, daemon=True)
    tracer.start()

    for line in sys.stdin:
        line = line.strip()
        if line:
            ctrl.control(line)
